# =============================
# FRONTEND (GitHub Pages build)
# =============================
# Render API base URL, including /api
VITE_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com/api

# =============================
# BACKEND (Render)
# =============================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
TELEGRAM_BOT_TOKEN=123456:YOUR_BOT_TOKEN

# YEGNA BINGO Super Admin Telegram ID
SUPER_ADMIN_TELEGRAM_ID=801812169

# GitHub Pages origin only (no path and no trailing slash)
ALLOWED_ORIGIN=https://YOUR-USERNAME.github.io

# Telegram bot wallet-request protection
WALLET_BOT_SECRET=replace-with-a-long-random-secret

# Telegram Mini App authentication
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
TELEGRAM_INIT_DATA_FUTURE_SKEW_SECONDS=60
SESSION_TTL_SECONDS=86400

# Full GitHub Pages Mini App URL
MINI_APP_URL=https://YOUR-USERNAME.github.io/yegna-bingo/

# Telegram webhook secret
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
